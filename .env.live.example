# Live tests (tests/live): a DEDICATED Cookidoo test account, never a personal one.
# Copy to .env.live (git-ignored) and fill in. COOKIDOO_EMAIL / COOKIDOO_PASSWORD are not used
# by the live tests, and they refuse to run when COOKIDOO_TEST_EMAIL equals COOKIDOO_EMAIL.
COOKIDOO_TEST_EMAIL=test-account@example.com
COOKIDOO_TEST_PASSWORD=test-account-password
COOKIDOO_TEST_COUNTRY=ch
COOKIDOO_TEST_LANGUAGE=de-CH
