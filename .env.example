# Cookidoo Credentials
COOKIDOO_EMAIL=your-email@example.com
COOKIDOO_PASSWORD=your-password-here

# Optional: Cookidoo site and recipe defaults
COOKIDOO_COUNTRY=fr
COOKIDOO_LANGUAGE=fr-FR
# Optional: Thermomix recipes are written for (TM5, TM6, TM7). Unset: detected from the
# devices linked to the account (TM6 if a TM6 is among them), else TM6.
# COOKIDOO_DEVICE=TM6

# Optional: folder(s) upload_custom_recipe_image may read photos from (":"-separated,
# ";" on Windows). Unset = image upload disabled. Use a folder with recipe photos only.
# COOKIDOO_IMAGE_DIRS=/home/you/RecipePhotos
